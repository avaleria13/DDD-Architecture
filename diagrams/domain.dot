digraph G { graph [rankdir=TB]; node [shape=record,fontname="Helvetica",fontsize=10]; edge [fontname="Helvetica",fontsize=9]; T [label="{SupportTicket «aggregate root»|id: TicketId\lreporterId, assigneeId\lstatus, urgency, priority\lversion\l|claim()\lset_priority()\ladvance()\lreassign()\l}"]; I [label="{TicketId «value object»|value: UUID}"]; E [label="{Event «immutable value»|version, kind, actorId\lbefore, after, reason, at\l}"]; A [label="{Actor «identity reference»|id, role}"]; R [label="{TicketRepository «interface»|add(), get(), save()}"]; P [label="{ConversationPolicy «domain service»|can_write()}"]; M [label="{MemoryTicketRepository|optimistic version check}"]; T -> E [dir=both,arrowtail=diamond,arrowhead=none,label="1 : 1..*"]; T -> I [dir=both,arrowtail=diamond,arrowhead=none]; T -> A [style=dashed,label="references"]; R -> T [style=dashed]; M -> R [style=dashed,arrowhead=empty]; P -> T [style=dashed]; P -> A [style=dashed]; }
